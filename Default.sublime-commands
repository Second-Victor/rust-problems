[
    {
        "caption": "Rust Problems: Check Project",
        "command": "rust_problems_check_project"
    },
    {
        "caption": "Rust Problems: Open Problems Tab",
        "command": "rust_problems_show_panel"
    },
    {
        "caption": "Rust Problems: Toggle Output Panel",
        "command": "rust_problems_toggle_panel"
    },
    {
        "caption": "Rust Problems: Next Problem",
        "command": "rust_problems_next"
    },
    {
        "caption": "Rust Problems: Previous Problem",
        "command": "rust_problems_previous"
    },
    {
        "caption": "Rust Problems: Clear",
        "command": "rust_problems_clear"
    },
    {
        "caption": "Preferences: Rust Problems Settings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/Rust Problems/Rust Problems.sublime-settings",
            "default": "// Rust Problems user settings\n{\n\t$0\n}\n"
        }
    },
    {
        "caption": "Preferences: Rust Problems Key Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/Rust Problems/Default.sublime-keymap",
            "default": "[\n\t$0\n]\n"
        }
    }
]
